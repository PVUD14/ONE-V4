{
	# Let's Encrypt sends certificate-expiry notices here.
	email info@ai8ht.pro
}

oneby8.com {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options DENY
		-Server
	}

	handle /health {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}

# The demo site (docs/ops/runbook-demo-site.md): sample data only, served from its own
# container. It gets the same security headers as oneby8.com, is kept out of search
# engines, and has no route to the API - a request for /api or /health here is refused
# rather than ever reaching production.
demo.oneby8.com {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Only the people Divakar lists may open the demo. The list lives on the server, in
	# deploy/vps/demo-access/users.caddy (one "username bcrypt-hash" per line; any *.caddy file there counts), never in
	# the repository; see docs/ops/runbook-demo-site.md. Each person gets their own line,
	# so access is granted and removed per person. With no file the demo stays locked
	# to everyone, and oneby8.com keeps running.
	basic_auth {
		import /etc/caddy/demo-access/*.caddy
	}

	handle /api/* {
		respond "Not available on the demo site" 404
	}

	handle /health {
		respond "Not available on the demo site" 404
	}

	handle {
		reverse_proxy web-demo:8080
	}
}

# One address only: www and the retired one.ai8ht.pro forward permanently to
# oneby8.com, keeping the path so old links and shared profile URLs still land.
# one.ai8ht.pro gets its certificate once its DNS record points at this server.
www.oneby8.com, one.ai8ht.pro {
	redir https://oneby8.com{uri} permanent
}
