{
  "name": "@planthepath/ai-evaluation",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bake-off:build-set": "tsx src/cli/build-set.ts",
    "bake-off:report": "tsx src/cli/report.ts",
    "bake-off:review-sheet": "tsx src/cli/review-sheet.ts"
  },
  "dependencies": {
    "@planthepath/ai-orchestration": "workspace:*",
    "@planthepath/career-readiness": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
