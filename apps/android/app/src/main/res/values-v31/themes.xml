<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded system splash (Android 12+): black brand ground, the ONE "o"
         mark as the centred icon and the tagline in the branding slot. The
         in-app splash (BrandSplash) continues it with the dot pulsing. -->
    <style name="Theme.One" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0B0C0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#0B0C0F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B0C0F</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
