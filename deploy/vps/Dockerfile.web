FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Every workspace member, not a hand-kept list: a missing member breaks the
# frozen install. apps/android is excluded by .dockerignore.
COPY apps apps
COPY packages packages

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./

# Browser configuration is fixed at build time; docker-compose.yml passes it from the
# server's .env. The Cognito values are public identifiers, not secrets. Redirect and
# logout URIs are left blank on purpose: the app then uses its own origin.
ARG VITE_API_BASE_URL=https://oneby8.com
ARG VITE_COGNITO_DOMAIN=
ARG VITE_COGNITO_CLIENT_ID=
ARG VITE_COGNITO_USER_POOL_ID=
ARG VITE_COGNITO_REDIRECT_URI=
ARG VITE_COGNITO_LOGOUT_URI=
# "true" builds the demo site for demo.oneby8.com instead of the real application
# (docker-compose.yml service web-demo). Left blank for oneby8.com.
ARG VITE_DEMO_SITE=

RUN pnpm --filter @planthepath/web build

# Fails the image build if the boundary between the two sites is crossed: the real
# application must ship no demo or pilot sample data, and the demo site must ship no
# real sign-in or application code (apps/web/scripts/check-demo-boundary.mjs).
RUN if [ "$VITE_DEMO_SITE" = "true" ]; then variant=demo; else variant=production; fi;     node apps/web/scripts/check-demo-boundary.mjs apps/web/dist "$variant"

FROM caddy:2.8-alpine AS runtime
COPY deploy/vps/web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 8080
