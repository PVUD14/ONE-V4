# Copy to .env on the VPS and chmod 600. Do not commit populated secrets.

# Temporary public UAT mode: permits missing Cognito config while protected
# endpoints remain fail-closed. Upgrade to NODE_ENV=production after approved
# non-production Cognito and automation secrets are provisioned.
NODE_ENV=development

POSTGRES_DB=planthepath_uat
POSTGRES_USER=planthepath_uat
POSTGRES_PASSWORD=replace-with-strong-server-generated-password
