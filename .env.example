NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://planthepath:replace-with-local-password@127.0.0.1:55432/planthepath_dev

# Required for Cognito-backed runtime authentication.
# Production startup fails without these values.
# Development startup without them is allowed, but protected routes fail closed.
COGNITO_USER_POOL_ID=ap-south-1_example
COGNITO_CLIENT_ID=example-client-id

# ADR-025 staff pool (MFA required). Leave both unset until the pool exists; unset,
# nothing changes. Set, both are required together, and the internal platform roles
# count only for tokens this pool issued. See docs/ops/runbook-staff-pool.md.
# COGNITO_STAFF_USER_POOL_ID=ap-south-1_exampleStaff
# COGNITO_STAFF_CLIENT_ID=example-staff-client-id

# Required in production for short-lived automation invocation/callback tokens.
# Use a secret-manager reference at deployment; never commit a populated value.
AUTOMATION_SIGNING_SECRET=
# Separate HS256 secret configured only in the worker and n8n JWT Auth credential.
PTP_N8N_INVOCATION_SECRET=

# Automation workers use the default AWS workload-identity credential chain.
# Never set static AWS access keys in repository configuration.
AUTOMATION_WORKER_MODE=outbox-publisher
PTP_EVENT_BUS_NAME=planthepath-development
PTP_AUTOMATION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/planthepath-development-events
PTP_N8N_BASE_URL=http://n8n:5678

# Background jobs alerts (OPS-04). Read by the API (System Health) and by the
# jobs:alert-check timer. Blank means the default: 10 failed events, 30 minutes waiting.
# Consumer silence is off unless listed, e.g. student-invitation-delivery=1440
# Known consumers: student-invitation-delivery, learner-content-seeded-generation-v1,
# learner-skill-state-projector
JOBS_ALERT_FAILED_THRESHOLD=
JOBS_ALERT_PENDING_STALL_MINUTES=
JOBS_ALERT_CONSUMER_SILENCE_MINUTES=

# Public frontend configuration. This is safe to expose in browser bundles.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Optional browser sign-in for local/non-production UAT.
# These values must point at an approved non-production Cognito Hosted UI app
# client configured for authorization-code + PKCE. Do not use production
# identity resources for local UAT. The browser stores only OAuth state/verifier;
# returned access tokens are kept in memory and sent as API bearer tokens.
VITE_COGNITO_DOMAIN=https://example-uat.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=example-uat-client-id
VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://127.0.0.1:5173/student

# Frontend-only product preview launcher at /demo.
# Role selection in the launcher does not authenticate or authorize a user.
# Keep disabled for production deployments unless a product-review environment
# explicitly opts in.
VITE_ENABLE_DEMO_PORTAL=true

# In-app assistant: OFF unless set to true. Switched off 2026-09-28 (OPS-SR-02) because it calls a model
# directly from a request handler; it returns only after moving onto ONE AI Orchestration.
ASSISTANT_ENABLED=false

# Sender for every ONE email (HG-7, chosen 2026-09-28). The domain must be set up to send (SPF/DKIM).
PTP_MAIL_FROM=info@ai8ht.pro

# Outgoing mail (docs/ops/runbook-mail-sender.md). Leave PTP_SMTP_HOST empty to send nothing — every email is
# then recorded NOT_CONFIGURED. When it is set, SECURITY, USER and PASSWORD must be set too or the API and the
# worker refuse to start. GoDaddy (info@ai8ht.pro): smtpout.secureserver.net, 465 with tls (or 587 with starttls).
# The password is set only on the server, by Divakar; never commit it.
PTP_SMTP_HOST=
PTP_SMTP_PORT=465
PTP_SMTP_SECURITY=tls
PTP_SMTP_USER=info@ai8ht.pro
PTP_SMTP_PASSWORD=
# Optional: the EHLO name (default one.ai8ht.pro) and the per-step timeout in ms (default 20000).
# PTP_SMTP_HELO_NAME=one.ai8ht.pro
# PTP_SMTP_TIMEOUT_MS=20000
