# Copy to .env on the VPS and chmod 600. Do not commit populated secrets.

# Temporary public UAT mode: permits missing Cognito config while protected
# endpoints remain fail-closed. Upgrade to NODE_ENV=production after approved
# non-production Cognito and automation secrets are provisioned.
NODE_ENV=development

# Outgoing mail through GoDaddy for info@ai8ht.pro (ADR-042, docs/ops/runbook-mail-sender.md).
# All blank = no email is sent (each is recorded NOT_CONFIGURED). To switch on: host
# smtpout.secureserver.net, port 465, security TLS, user info@ai8ht.pro. The password is
# typed here ON THE SERVER ONLY (sudo nano .env) — never in the repository or a ticket.
# If the host is set, the user and password must be too, or the API refuses to start.
PTP_SMTP_HOST=
PTP_SMTP_PORT=
PTP_SMTP_SECURITY=
PTP_SMTP_USER=
PTP_SMTP_PASSWORD=

# AI inference endpoint (ADR-047, docs/ops/runbook-inference-endpoint.md). All three blank = AI
# unavailable (every AI job fails PROVIDER_UNCONFIGURED; nothing crashes). Base URL is the pod's
# OpenAI-compatible address ending in /v1, e.g. https://<pod-id>-8888.proxy.runpod.net/v1 (the pod
# id changes when the pod is recreated). The key is copied from the pod's /root/one-ai/api-key and
# typed here ON THE SERVER ONLY (sudo nano .env) — never in the repository or a ticket.
ONE_AI_BASE_URL=
ONE_AI_API_KEY=
ONE_AI_MODEL=

# Embedding endpoint (ENG-24, ADR-050). All three blank = retrieval unavailable (the embedding job
# does nothing and says so). No embedding model is served yet; the key is typed ON THE SERVER ONLY.
ONE_AI_EMBEDDING_BASE_URL=
ONE_AI_EMBEDDING_API_KEY=
ONE_AI_EMBEDDING_MODEL=

POSTGRES_DB=planthepath_uat
POSTGRES_USER=planthepath_uat
POSTGRES_PASSWORD=replace-with-strong-server-generated-password

# Sign-in (Cognito). Copy these values from the previous server's app.env. They are
# identifiers, not passwords. Do NOT copy VITE_COGNITO_REDIRECT_URI or
# VITE_COGNITO_LOGOUT_URI: the web app derives them from https://oneby8.com, and the
# Cognito app client must list https://oneby8.com/auth/callback and /login.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_STAFF_USER_POOL_ID=
COGNITO_STAFF_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=

# Automation signing secret: a secret. Copy from the previous server's app.env if
# it is set there; leave blank otherwise.
AUTOMATION_SIGNING_SECRET=

# ---------------------------------------------------------------------------------------
# demo.oneby8.com - the sandbox (ADR-046, docs/ops/runbook-demo-site.md). Everything below
# is for the sandbox only; production ignores it. All blank = the sandbox is not started
# and oneby8.com runs exactly as before.
#
# Start the sandbox with the rest of the pack. Leave blank to keep it off.
#   COMPOSE_PROFILES=sandbox
COMPOSE_PROFILES=

# The sandbox database's own password: a secret, generated on the server
# (openssl rand -hex 24). Never the production POSTGRES_PASSWORD.
DEMO_POSTGRES_PASSWORD=

# The sandbox's OWN Cognito user pool (runbook step 3) - never the production pool, so a
# demo account can never sign in to oneby8.com and no real account can sign in here.
# Identifiers, not passwords. Blank = the sandbox API refuses every sign-in.
DEMO_COGNITO_USER_POOL_ID=
DEMO_COGNITO_CLIENT_ID=
# The pool's hosted sign-in domain, as a full address, e.g.
# https://one-sandbox-<suffix>.auth.ap-south-1.amazoncognito.com
DEMO_COGNITO_DOMAIN=

# Which sandbox-pool user is which demo persona: persona=sub pairs, comma separated, where
# "sub" is the user's "User ID (sub)" in the sandbox pool. Identifiers, not passwords.
# Personas: student, graduate, placement, institution-admin, lecturer, department-head,
# employer, operations, growth (docs/marketing/demo-script.md).
#   DEMO_ACCOUNT_SUBJECTS=student=1a2b...,placement=3c4d...
DEMO_ACCOUNT_SUBJECTS=

# AI for the demo sandbox only (ENG-22/23, ADR-047). The pod's address
# (https://<pod-id>-8888.proxy.runpod.net/v1), the key from /root/one-ai/api-key on the pod
# (type it here, never in chat or the repository), and the served model name. Production's
# ONE_AI_* stay blank, so AI cannot reach oneby8.com through these.
DEMO_ONE_AI_BASE_URL=
DEMO_ONE_AI_API_KEY=
DEMO_ONE_AI_MODEL=
