{
  "name": "@planthepath/persistence",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:register:n8n": "tsx src/register-n8n-workflows.ts",
    "db:seed:career-readiness": "tsx src/seed-career-readiness-pilot.ts",
    "db:seed:local-users": "tsx src/seed-local-users.ts",
    "db:seed:careers": "tsx src/seed-careers.ts",
    "db:import:teaching-strategies-draft": "tsx src/import-teaching-strategies-draft.ts",
    "engine:rebuild-skill-state": "tsx src/rebuild-learner-skill-state.ts",
    "engine:bkt-shadow-report": "tsx src/run-bkt-shadow-report.ts",
    "jobs:alert-check": "tsx src/run-jobs-alert-check.ts",
    "test": "vitest run --fileParallelism=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:automation": "tsx src/run-automation-worker.ts",
    "worker:content-generation": "tsx src/run-content-generation-worker.ts"
  },
  "dependencies": {
    "@planthepath/authorization": "workspace:*",
    "@planthepath/career-readiness": "workspace:*",
    "@planthepath/identity": "workspace:*",
    "@planthepath/automation": "workspace:*",
    "@planthepath/events": "workspace:*",
    "@planthepath/learner-content": "workspace:*",
    "@planthepath/learning-model": "workspace:*",
    "@planthepath/mastery-bkt": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0",
    "@planthepath/ai-orchestration": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
