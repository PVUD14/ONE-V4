FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Every workspace member, not a hand-kept list: a missing member breaks the
# frozen install. apps/android is excluded by .dockerignore.
COPY apps apps
COPY packages packages

RUN pnpm install --frozen-lockfile

COPY data data
COPY tsconfig.base.json ./

RUN pnpm --filter @planthepath/api... build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=development
# pnpm is fetched here, as root, into a shared read-only cache: the unprivileged user
# cannot write a corepack cache of its own, and a download at start-up made every
# fresh server's API crash-loop. Only the migration command uses pnpm.
ENV COREPACK_HOME=/usr/local/share/corepack COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN corepack enable \
  && corepack prepare pnpm@10.15.0 --activate \
  && chmod -R a+rX /usr/local/share/corepack \
  && groupadd --system planthepath \
  && useradd --system --gid planthepath --home /app --shell /usr/sbin/nologin planthepath

COPY --from=build --chown=planthepath:planthepath /app /app

USER planthepath
EXPOSE 3000
# The workspace packages are consumed as TypeScript source ("./src/*" exports), so the
# compiled API starts under tsx, which resolves their .js imports to the .ts files.
WORKDIR /app/apps/api
CMD ["node", "--import", "tsx", "dist/main.js"]
