FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/authorization/package.json packages/authorization/package.json
COPY packages/automation/package.json packages/automation/package.json
COPY packages/career-readiness/package.json packages/career-readiness/package.json
COPY packages/events/package.json packages/events/package.json
COPY packages/identity/package.json packages/identity/package.json
COPY packages/persistence/package.json packages/persistence/package.json

RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages packages
COPY data data
COPY tsconfig.base.json ./

RUN pnpm --filter @planthepath/api... build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=development

RUN corepack enable \
  && groupadd --system planthepath \
  && useradd --system --gid planthepath --home /app --shell /usr/sbin/nologin planthepath

COPY --from=build --chown=planthepath:planthepath /app /app

USER planthepath
EXPOSE 3000
CMD ["pnpm", "--filter", "@planthepath/api", "start"]
