FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Every workspace member, not a hand-kept list: a missing member breaks the
# frozen install. apps/android is excluded by .dockerignore.
COPY apps apps
COPY packages packages

RUN pnpm install --frozen-lockfile

COPY data data
COPY tsconfig.base.json ./

RUN pnpm --filter @planthepath/api... build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=development

RUN corepack enable \
  && groupadd --system planthepath \
  && useradd --system --gid planthepath --home /app --shell /usr/sbin/nologin planthepath

COPY --from=build --chown=planthepath:planthepath /app /app

USER planthepath
EXPOSE 3000
CMD ["pnpm", "--filter", "@planthepath/api", "start"]
