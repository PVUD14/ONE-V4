# Copy to .env on the VPS and chmod 600. Do not commit populated secrets.

# Temporary public UAT mode: permits missing Cognito config while protected
# endpoints remain fail-closed. Upgrade to NODE_ENV=production after approved
# non-production Cognito and automation secrets are provisioned.
NODE_ENV=development

# Outgoing mail through GoDaddy for info@ai8ht.pro (ADR-042, docs/ops/runbook-mail-sender.md).
# All blank = no email is sent (each is recorded NOT_CONFIGURED). To switch on: host
# smtpout.secureserver.net, port 465, security TLS, user info@ai8ht.pro. The password is
# typed here ON THE SERVER ONLY (sudo nano .env) — never in the repository or a ticket.
# If the host is set, the user and password must be too, or the API refuses to start.
PTP_SMTP_HOST=
PTP_SMTP_PORT=
PTP_SMTP_SECURITY=
PTP_SMTP_USER=
PTP_SMTP_PASSWORD=

POSTGRES_DB=planthepath_uat
POSTGRES_USER=planthepath_uat
POSTGRES_PASSWORD=replace-with-strong-server-generated-password

# Sign-in (Cognito). Copy these values from the previous server's app.env. They are
# identifiers, not passwords. Do NOT copy VITE_COGNITO_REDIRECT_URI or
# VITE_COGNITO_LOGOUT_URI: the web app derives them from https://oneby8.com, and the
# Cognito app client must list https://oneby8.com/auth/callback and /login.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_STAFF_USER_POOL_ID=
COGNITO_STAFF_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=

# Automation signing secret: a secret. Copy from the previous server's app.env if
# it is set there; leave blank otherwise.
AUTOMATION_SIGNING_SECRET=
