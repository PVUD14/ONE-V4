[Unit]
Description=Run the ONE database backup daily
Documentation=https://github.com/PVUD14/planthepath-next

[Timer]
# 01:30 IST, before the privacy deletion sweep at 02:30, so a day's backup always
# predates that day's irreversible erasures.
OnCalendar=*-*-* 20:00:00 UTC

# A backup missed because the host was down runs at next boot rather than leaving a
# gap in the chain.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
