# The sandbox's nightly reset (ADR-046, docs/ops/runbook-demo-site.md step 6).
# Drops the sandbox database (one_sandbox, in the postgres-demo container - never the
# production database), migrates it and loads the sample data again. Installed on the
# server by Divakar:
#   sudo cp deploy/vps/demo-sandbox/one-sandbox-reset.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now one-sandbox-reset.timer
# WorkingDirectory assumes the pack lives at /srv/one; change it if it does not.
[Unit]
Description=Reset the ONE sandbox (demo.oneby8.com) to its sample data
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/one/deploy/vps
ExecStart=/usr/bin/docker compose --profile sandbox --profile sandbox-tools run --rm sandbox-reset
TimeoutStartSec=900
