FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/authorization/package.json packages/authorization/package.json
COPY packages/automation/package.json packages/automation/package.json
COPY packages/career-readiness/package.json packages/career-readiness/package.json
COPY packages/events/package.json packages/events/package.json
COPY packages/identity/package.json packages/identity/package.json
COPY packages/persistence/package.json packages/persistence/package.json
COPY apps/api/package.json apps/api/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY tsconfig.base.json ./

RUN pnpm --filter @planthepath/web build

FROM caddy:2.8-alpine AS runtime
COPY deploy/vps/web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 8080
