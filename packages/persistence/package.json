{
  "name": "@planthepath/persistence",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed:career-readiness": "tsx src/seed-career-readiness-pilot.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@planthepath/career-readiness": "workspace:*",
    "@planthepath/events": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
