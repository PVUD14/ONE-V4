<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded system splash (Android 12+): the brand's black ground, the 8 as
         the center mark, and the full AI8HT wordmark as the branding image -->
    <style name="Theme.One" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#0B0C0F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B0C0F</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
