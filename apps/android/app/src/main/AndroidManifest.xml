<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GROWTH-06: the offline field queue is sent when a network appears. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GROWTH-06 (design 14.3): approximate location, asked for only when a growth person taps
         "Attach my location" on a visit, and read only then. Never fine, never background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.One"
        android:supportsRtl="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth redirect for the Cognito PKCE flow (activates once the
                 mobile app client exists; scheme matches OAUTH_REDIRECT_URI). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="one.ai8ht.pro" android:host="signin" />
            </intent-filter>
        </activity>

        <!-- GROWTH-06: the morning reminder for a growth follow-up, scheduled on the phone. -->
        <receiver
            android:name=".GrowthReminderReceiver"
            android:exported="false" />
    </application>
</manifest>
